---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | default: "Shay's Digital Home" | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author | default: "Shay" | xml_escape }}</name>
  </author>

  {% for post in site.posts limit: 20 %}
    <entry>
      <title>{{ post.title | xml_escape }}</title>
      <link href="{{ site.url }}{{ post.url }}"/>
      <updated>{{ post.date | date_to_xmlschema }}</updated>
      <id>{{ site.url }}{{ post.url }}</id>
      <summary type="html">{{ post.summary | default: post.excerpt | strip_html | xml_escape }}</summary>
      <content type="html">
        <![CDATA[
          <div style="font-family: system-ui, sans-serif; line-height: 1.6; color: #2c2a29; max-width: 600px;">
            {% assign words = post.content | strip_html | number_of_words %}
            {% assign read_time = words | divided_by: 180 | at_least: 1 %}
            {% assign content_imgs = post.content | split: '<img' | size | minus: 1 %}
            {% assign strip_imgs = post.photos.size | default: post.gallery.size | default: 0 %}
            {% assign total_photos = content_imgs | plus: strip_imgs %}

            <p style="color: #736e68; font-size: 0.88em; margin-bottom: 1.2em;">
              <span>⏱️ {{ read_time }} min read ({{ words }} words)</span>
              {% if total_photos > 0 %}
                <span> &bull; 📷 Includes {{ total_photos }} {% if total_photos == 1 %}photo{% else %}photos{% endif %}</span>
              {% endif %}
            </p>

            <div style="font-size: 1.05em; margin: 1.2em 0;">
              {% if post.summary %}
                <p>{{ post.summary }}</p>
              {% else %}
                <p>{{ post.excerpt | strip_html | truncatewords: 50 }}</p>
              {% endif %}
            </div>

            <p style="margin: 1.5em 0;">
              <a href="{{ site.url }}{{ post.url }}" style="color: #9c4125; font-weight: bold; text-decoration: underline;">
                Read the full post and view photos on the website &rarr;
              </a>
            </p>

            {% if post.previous %}
              <p style="font-size: 0.88em; color: #5e5a56; margin: 1.5em 0 1em;">
                ⏮️ <strong>In case you missed it:</strong>
                <a href="{{ site.url }}{{ post.previous.url }}" style="color: #9c4125; text-decoration: underline;">
                  {{ post.previous.title }}
                </a>
              </p>
            {% endif %}

            <hr style="border: none; border-top: 1px dashed #e2ded6; margin: 2em 0 1.2em;" />

            <p style="color: #5e5a56; font-size: 0.9em; margin-bottom: 0.8em;">
              💬 <em>Have thoughts, recommendations, or just want to say hi? Hit reply to this email or reach out on my site — I&apos;d love to hear from you!</em>
            </p>

            <p style="color: #5e5a56; font-style: italic; font-size: 0.9em; margin-top: 0.5em;">
              Thanks for taking an interest :)
            </p>
          </div>
        ]]>
      </content>
    </entry>
  {% endfor %}
</feed>
